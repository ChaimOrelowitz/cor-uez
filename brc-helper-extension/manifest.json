{
  "manifest_version": 3,
  "name": "COR UEZ Document Helper",
  "version": "1.0.4",
  "description": "Runs BRC and tax-clearance retrieval when started from the COR UEZ admin app.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*",
    "https://cor-uez-api.onrender.com/*",
    "https://cor-uez.vercel.app/*",
    "https://uez.corsolutions.io/*",
    "https://*.state.nj.us/*",
    "https://*.nj.gov/*",
    "https://my.nj.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "https://cor-uez.vercel.app/*",
        "https://uez.corsolutions.io/*"
      ],
      "js": ["appBridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.state.nj.us/*",
        "https://*.nj.gov/*",
        "https://my.nj.gov/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
