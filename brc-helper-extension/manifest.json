{
  "manifest_version": 3,
  "name": "COR UEZ Document Helper",
  "version": "1.3.0",
  "description": "Runs BRC, tax-clearance, Lakewood LDC, and Lakewood grant-submission workflows from the COR UEZ admin app.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*",
    "https://cor-uez-api.onrender.com/*",
    "https://cor-uez.vercel.app/*",
    "https://uez.corsolutions.io/*",
    "https://*.state.nj.us/*",
    "https://*.nj.gov/*",
    "https://my.nj.gov/*",
    "https://form.jotform.com/*",
    "https://submit.jotform.com/*",
    "https://*.jotform.com/*",
    "https://www.uezapps.lakewoodnj.gov/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.vercel.app/*",
        "https://cor-uez.vercel.app/*",
        "https://uez.corsolutions.io/*"
      ],
      "js": [
        "appBridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.state.nj.us/*",
        "https://*.nj.gov/*",
        "https://my.nj.gov/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://*.jotform.com/*"
      ],
      "js": [
        "jotform.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://form.jotform.com/222748639284165*",
        "https://submit.jotform.com/*"
      ],
      "js": [
        "grant-jotform.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
